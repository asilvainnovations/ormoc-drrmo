{
  "name": "ormoc-drrm-ops",
  "private": true,
  "version": "1.3.0",
  "description": "Ormoc City CDRRMO & EOC Operations Platform – mobile-first PWA",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/db_test.sh",
    "test:e2e": "bash scripts/e2e_test.sh",
    "seed:generate": "python3 scripts/generate_seed.py",
    "seed:operational": "python3 scripts/generate_operational_seed.py",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:it": "bash scripts/it_test.sh"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/roboto-condensed": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "2.1.1",
    "dexie": "4.0.8",
    "dexie-react-hooks": "1.1.7",
    "dompurify": "3.1.7",
    "lucide-react": "0.453.0",
    "marked": "14.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.56.0",
    "@testing-library/react": "16.0.1",
    "@types/dompurify": "3.0.5",
    "@types/node": "22.7.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.4"
  }
}
