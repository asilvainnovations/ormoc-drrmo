# MODE web app settings. Copy to .env (never commit .env) and fill in.
# Only VITE_ variables reach the browser. Never put a secret key, service-role key
# or database password in any VITE_ variable or in this repository.

# Supabase project address: https://<project-ref>.supabase.co (no path).
# Production (City): https://jmctsspadywjcbbqwweh.supabase.co
# For training and validation workshops use the separate training project instead.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...), from Project Settings -> API Keys.
# It is safe in the browser: Row Level Security decides what each account can read.
# Older projects can use VITE_SUPABASE_ANON_KEY instead.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Canonical public address; enables /sitemap.xml.
# VITE_SITE_URL=https://www.mode-cddrmo-ormoc.online

# Optional. Override the approved policy snapshot shown on the public policy pages.
# VITE_POLICY_EFFECTIVE=
# VITE_POLICY_OWNER=

# Optional. Contact and registration details shown on the public pages.
# VITE_SUPPORT_EMAIL=
# VITE_DPO_EMAIL=
# VITE_NPC_REGISTRATION=
# VITE_BUSINESS_ADDRESS=

# Optional. City-hosted PMTiles basemap for the Geo-COP (built by .github/workflows/basemap.yml).
# VITE_BASEMAP_URL=
