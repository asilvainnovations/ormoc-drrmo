# MODE web app settings. In Vercel: Project -> Settings -> Environment Variables (Production), then redeploy.
# On your own computer: copy this file to .env (never commit .env).
# Only VITE_ variables reach the browser, and anyone can read them there. Never put a secret key, service-role key,
# database password or Google client secret in any VITE_ variable or in this repository.
#
# Blank or missing = the built-in default shown below is used. You only need the two REQUIRED lines.

# REQUIRED. The City's Supabase project address (no path, no trailing slash).
# Production: https://jmctsspadywjcbbqwweh.supabase.co
# A training or workshop deployment uses the separate training project's address instead.
VITE_SUPABASE_URL=https://jmctsspadywjcbbqwweh.supabase.co

# REQUIRED. Supabase -> Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_).
# Safe in the browser: Row Level Security decides what each account can read. Older projects: VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. The public address. Default: https://www.mode-cddrmo-ormoc.online. Set only if the domain changes.
# VITE_SITE_URL=https://www.mode-cddrmo-ormoc.online

# Optional. Leave both blank. The public policy pages already show the approved snapshot:
#   effective 9 November 2026, approved by the City Legal Office and City Data Protection Officer.
# Fill them in only when the City re-issues the policies, for example:
#   VITE_POLICY_EFFECTIVE=1 January 2027
#   VITE_POLICY_OWNER=City Legal Office and City Data Protection Officer
# VITE_POLICY_EFFECTIVE=
# VITE_POLICY_OWNER=

# Optional. Contact details on the public pages. Defaults:
#   support  mode-support@asilvainnovations.com
#   DPO      cdrrmo.ormoccity@gmail.com
#   address  New Ormoc City Hall, Anubing St., Brgy. Cogon, Ormoc City, Leyte
# Set one only to change it (for example a new support mailbox after turnover).
# VITE_SUPPORT_EMAIL=
# VITE_DPO_EMAIL=
# VITE_BUSINESS_ADDRESS=

# Optional. The City's National Privacy Commission registration number. Leave blank unless the City has one and
# wants it shown: publishing it is not required (ADR-045), and nothing is shown while it is blank.
# VITE_NPC_REGISTRATION=

# Optional. Leave blank. The Geo-COP basemap is read from the City's Supabase "basemap" bucket by default.
# Set only if the basemap is served from a City web server instead (that server must also be added to the CSP).
# VITE_BASEMAP_URL=

# "on" shows "Continue with Google" and "Sign up with Google". Turn the Google provider on in Supabase first
# (DEPLOY.md 2b); until then leave it "off", so nobody sees a button that does not work.
VITE_GOOGLE_SIGN_IN=off

# NOT for Vercel. Only in .env on the computer that runs scripts/apply_db.sh (ADR-034). It holds the database
# password, so it is never prefixed VITE_ and never reaches the app.
# Supabase Dashboard -> Connect -> Session pooler (port 5432), with the password filled in.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
